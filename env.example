# =============================================================================
# CERCOLLETTIVA - CONFIGURAZIONE AMBIENTE DOCKER
# =============================================================================
# Questo file contiene tutte le variabili d'ambiente per l'applicazione CerCollettiva
# in ambiente Docker. Per produzione, modifica i valori di conseguenza.

# =============================================================================
# DATABASE POSTGRESQL
# =============================================================================
# Configurazione database PostgreSQL (container 'db')
DB_NAME=cercollettiva                    # Nome del database
DB_USER=cercollettiva_user               # Username per connessione DB
DB_PASSWORD=cercollettiva_pass           # Password per connessione DB
DB_HOST=db                               # Host database (nome container Docker)
DB_PORT=5432                             # Porta PostgreSQL

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================
# Configurazioni base Django
DEBUG=True                               # Modalità debug (True=sviluppo, False=produzione)
SECRET_KEY=your-secret-key-here-change-this-in-production  # Chiave segreta Django (GENERA NUOVA PER PRODUZIONE!)
FIELD_ENCRYPTION_KEY=your-encryption-key-here-change-this-in-production  # Chiave per crittografia campi sensibili
ALLOWED_HOSTS=*                          # Host consentiti (* = tutti per sviluppo)

# =============================================================================
# NGINX REVERSE PROXY
# =============================================================================
# Configurazione Nginx (dev=HTTP, prod=HTTPS)
NGINX_ENV=dev                            # Ambiente Nginx (dev/prod)

# =============================================================================
# REDIS CACHE E SESSIONI
# =============================================================================
# Configurazione Redis per cache e sessioni (container 'redis')
REDIS_URL=redis://redis:6379/1           # URL Redis (Docker: redis, Native: localhost)
REDIS_PASSWORD=redis_pass                # Password Redis (opzionale)

# =============================================================================
# MQTT BROKER
# =============================================================================
# Configurazione broker MQTT per dispositivi IoT (container 'mqtt')
MQTT_HOST=mqtt                           # Host broker MQTT (Docker: mqtt, Native: localhost)
MQTT_PORT=1883                           # Porta MQTT (1883=non sicura, 8883=TLS)
MQTT_USER=                               # Username MQTT (opzionale)
MQTT_PASS=                               # Password MQTT (opzionale)
MQTT_QOS=1                               # Quality of Service (0,1,2)
MQTT_KEEPALIVE=60                        # Keepalive in secondi
MQTT_TLS=False                           # Usa TLS per MQTT (True/False)

# =============================================================================
# EMAIL SMTP
# =============================================================================
# Configurazione invio email (opzionale per sviluppo)
EMAIL_HOST=smtp.gmail.com                # Server SMTP
EMAIL_PORT=587                           # Porta SMTP (587=TLS, 465=SSL)
EMAIL_USE_TLS=True                       # Usa TLS per SMTP
EMAIL_HOST_USER=                         # Username email (opzionale)
EMAIL_HOST_PASSWORD=                     # Password email (opzionale)
DEFAULT_FROM_EMAIL=noreply@cercollettiva.it  # Email mittente predefinita

# =============================================================================
# LOGGING E DEBUG
# =============================================================================
# Configurazione logging e debug
DJANGO_LOG_LEVEL=DEBUG                   # Livello log (DEBUG/INFO/WARNING/ERROR)
ENABLE_DEBUG_TOOLBAR=True                # Abilita Django Debug Toolbar (solo sviluppo)

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Abilita/disabilita funzionalità
ENABLE_BACKUP=False                      # Abilita backup automatico Docker
ENERGY_CACHE_ENABLED=True                # Abilita cache per dati energetici

# =============================================================================
# FILE UPLOAD
# =============================================================================
# Limiti per upload file
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880      # Max dimensione file in memoria (5MB)
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880      # Max dimensione dati upload (5MB)

# =============================================================================
# GDPR E PRIVACY
# =============================================================================
# Configurazioni GDPR
GDPR_ENABLED=True                        # Abilita funzionalità GDPR
USER_RETENTION_DAYS=2555                 # Giorni retention dati utente (7 anni)
LOG_RETENTION_DAYS=365                   # Giorni retention log (1 anno)

# =============================================================================
# MONITORING E GRAFANA
# =============================================================================
# Configurazione monitoring
GRAFANA_PASSWORD=admin                   # Password admin Grafana

# =============================================================================
# PRODUZIONE (opzionale - decommentare per produzione)
# =============================================================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_SAMPLE_RATE=0.2
# SENTRY_ENVIRONMENT=production
# DJANGO_ADMIN_URL=ceradmin/
# USE_S3=False
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_REGION_NAME=eu-west-1
# SERVER_EMAIL=server@cercollettiva.it

